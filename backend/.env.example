# ILY-mart / Homly Backend Configuration Environment Variables

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ilayangudi
JWT_SECRET=your_jwt_secret_here

# Telegram Notification Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Notification (Optional - Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=

# ntfy.sh Mobile Push Notification (Optional)
NTFY_TOPIC=homly-alerts-556677

# Voice Call Alert (Optional - IFTTT)
IFTTT_WEBHOOK_URL=

# n8n Automation Webhooks (Optional - Unlimited Free Automations)
# Base Webhook URL (receives all events if specific URLs are not set)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ilymart-events
# Optional specific webhooks for orders and service requests:
N8N_ORDER_WEBHOOK_URL=
N8N_SERVICE_WEBHOOK_URL=
